FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Never commit a real production secret.
SECRET_KEY=change-me-in-local-env

# Existing MySQL database used by Site 3 persistence.
# Site 3 accepts both DB_* and the legacy DATABASE_* names used by Site 2.
# Local defaults remain compatible with the existing setup:
# host=127.0.0.1, port=3306, database=main_bd, user=root, password empty.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=main_bd
DB_USER=root
DB_PASSWORD=

# Legacy aliases are also supported:
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=main_bd
# DATABASE_USER=root
# DATABASE_PASSWORD=

# Public location target used by the globe pin.
# GOOGLE_MAPS_URL=


# Contact notification email.
# Sender and recipient are intentionally the same internal mailbox.
# Fill SMTP_HOST / SMTP_PASSWORD with the provider settings for this mailbox.
SMTP_HOST=smtp.copyminas.com.br
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=ti.processos@copyminas.com.br
SMTP_PASSWORD=
CONTACT_NOTIFICATION_FROM=ti.processos@copyminas.com.br
CONTACT_NOTIFICATION_TO=ti.processos@copyminas.com.br
