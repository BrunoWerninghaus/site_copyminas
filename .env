# ── BANCO DE DADOS ────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=HatsuYurbagoAcvs120523
DATABASE_NAME=main_bd
DATABASE_PORT=3306

# ── FLASK SECURITY ────────────────────────────────────────
# Chave secreta para sessões e CSRF
# Para gerar uma nova: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=f8d4e2a9b1c3f5g7h9j2k4m6n8p0q2s4t6v8w0y2z4a6b8c0e2f4g6h8i0j2k4

# ── AMBIENTE ──────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=0

# ── SESSÃO ────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=False           # True em produção com HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ── RATE LIMITING ────────────────────────────────────────
LOGIN_RATE_LIMIT=5 per minute
REGISTER_RATE_LIMIT=3 per minute
API_RATE_LIMIT=200 per day, 50 per hour

# ── LOGGING ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
